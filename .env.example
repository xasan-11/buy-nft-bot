# --- Your Telegram user account (used to read channels and place purchases) ---
# Get these from https://my.telegram.org -> API Development Tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+15551234567

# --- Owner ---
# Your numeric Telegram user ID (get it from @userinfobot). This account
# always stays an administrator and cannot be removed via /removeadmin.
OWNER_TELEGRAM_ID=

# --- Control bot ---
# A separate Bot API token from @BotFather. This bot is what you and other
# admins send /addadmin, /add, /stop, /sstart, /status etc. to. It is NOT
# the same account as TELEGRAM_PHONE above and never sees your password.
CONTROL_BOT_TOKEN=

# --- Purchase / monitoring behavior ---
# Maximum listing price, in Telegram Stars, that will be auto-purchased.
# This is a MAXIMUM price only — there is no minimum balance requirement.
MAX_NFT_PRICE=200

# Kept for compatibility with polling-style deployments. The default
# implementation uses Telethon's event-driven updates (no polling), so this
# value is currently unused but reserved for future polling fallbacks.
POLL_INTERVAL=1

# Maximum number of concurrent payments.getResaleStarGifts requests the
# market scanner is allowed to have in flight at once (asyncio.Semaphore).
# Also changeable live in the database via Repository.set_market_poll_concurrency.
MARKET_POLL_CONCURRENCY=3

# Target seconds between the start of one market-monitoring poll cycle and
# the next (a full cycle scans every resalable gift type). Never goes below
# an internal safety floor regardless of this value, to respect Telegram
# rate limits.
MARKET_POLL_INTERVAL_SECONDS=5
